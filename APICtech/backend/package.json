{
  "name": "apictech-backend",
  "version": "1.0.0",
  "description": "APICtech Smart Beekeeping Backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon src/server.js\" \"python ../beehive/python_app/app.py\"",
    "start": "concurrently \"node src/server.js\" \"python ../beehive/python_app/app.py\"",
    "db:verify": "node scripts/db.mjs verify",
    "db:backup": "node scripts/db.mjs backup",
    "db:list": "node scripts/db.mjs list",
    "db:check": "node scripts/db.mjs check",
    "db:local": "node scripts/local-postgres.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multiformats": "^14.0.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.10"
  }
}
