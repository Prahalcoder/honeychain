PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CAPTAIN_API_KEY=replace-with-a-device-or-app-key
# Public page a consumer's phone opens when scanning a bottle QR. Leave it out and the computer's Wi-Fi address is used. On a phone,
# localhost will not work: use your LAN IP or the deployed frontend URL.
# PUBLIC_VERIFY_PAGE_URL=http://192.168.1.8:5175/verify

# --- Database. Leave EMPTY to use the PostgreSQL server that npm start runs on this computer
# (127.0.0.1:54329, database honeychain, user/password postgres). Only set it for another server, e.g. Supabase:
# Project Settings > Database > Connection string > Session pooler (or Transaction pooler), user "postgres".
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DB_POOL_SIZE=10

# --- Signing accounts: encrypts the keeper and officer wallets kept in the database. Optional locally (a key file is created), keep it safe.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WALLET_MASTER_KEY=

# --- Blockchain. Leave EMPTY to use the local chain that npm start runs (http://127.0.0.1:8545). Only for a public testnet:
# CHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# CHAIN_PRIVATE_KEY=0x...                 # server account that pays gas; test funds only (faucet.polygon.technology)
# HONEYCHAIN_CONTRACT=0x...               # optional: blockchain/deployments/80002.json is used otherwise
# CHAIN_EXPLORER_URL=https://amoy.polygonscan.com
# CHAIN_ANCHOR_EVERY_SECONDS=600          # how often the ledger head is written on chain (20 on a local chain)
# CHAIN_ENABLED=true                      # false switches the smart-contract link off
# ETHERSCAN_API_KEY=                      # only for "npm run verify" in blockchain/
# IPFS_API_URL=http://127.0.0.1:5001      # also pin metadata to an IPFS (Kubo) node

# --- Other
# CORS_ORIGINS=https://admin.example.org,https://app.example.org
# REQUIRE_LAB_DOCUMENT=true               # make the scanned lab certificate (PDF, up to 10 MB) compulsory
# REQUIRE_REGISTRATION_DOCUMENTS=true     # make the scanned FSSAI licence compulsory before a company can be approved
# BACKUP_DIR=./backups   BACKUP_KEEP=14   BACKUP_EVERY_HOURS=24   BACKUPS=off
# SKIP_DB_CHECK=1                         # start even if a schema cannot be read
# LOGIN_RATE_LIMIT=100                    # attempts per 15 minutes per address
# NODE_ENV=production                     # refuses a weak JWT_SECRET
# TRUST_PROXY=1                           # when behind a reverse proxy
# PUBLIC_WEBSITE_URL=http://localhost:5175 # the link sent in an order confirmation e-mail

# --- Order confirmation e-mails (optional: without these, e-mails are only logged and saved
# under data/outbox/ so the order flow still works with no mail account)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=                              # a Gmail "app password" (myaccount.google.com/apppasswords), not your normal one
# SMTP_FROM=you@gmail.com

# --- Hive-health SMS alerts (no GSM module on the hive: the hive monitor's AI check reports a problem to this
# API, which texts the keeper). Without a provider, messages are only saved under data/outbox/sms-*.txt.
# In India, real commercial SMS needs DLT-registered sender IDs and templates (TRAI), arranged with the provider.
# SMS_PROVIDER=fast2sms                    # fast2sms or twilio
# FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=q                         # q = quick route (no DLT, for demos); use your DLT route in production
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx                 # a Twilio number; a trial account only texts numbers you verified
# HIVE_ALERT_COOLDOWN_HOURS=6              # the same problem on the same hive is texted at most once per this
